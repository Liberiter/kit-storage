# 여러분이 손으로 적는 파일과, 여러분 컴퓨터에만 있는 것들은 이 kit의 배포에서
# 빠집니다. 그래야 kit이 갱신되어도 적어 두신 내용이 덮이지 않고, 갱신을 받는
# 것도 막히지 않습니다.

# 마무리 문제의 답을 적는 파일. ./setup.sh 가 없으면 만들어 드리고, 이미 있으면
# 손대지 않습니다.
/exit/*
!/exit/templates/

# 여러분이 .py 파일을 만들어 실행하는 자리. 안에 무엇을 두셔도 그대로 둡니다.
/work/*
!/work/.gitkeep

# 프로그램이 만들어 내는 결과 파일 자리. ./reset.sh 가 비웁니다.
/out/*
!/out/.gitkeep

# 어느 경로로 구축했는지 적어 두는 파일. 여러분 컴퓨터의 상태이지 학습 자료가
# 아닙니다.
/.kit-mode

# 파이썬과 도구가 들어가는 프로젝트 환경, 그리고 도구가 남기는 임시 자리입니다.
/.venv/
/.ruff_cache/
/.pytest_cache/
/.mypy_cache/
/.entry-staging/
